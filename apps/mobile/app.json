{
  "expo": {
    "name": "Evacuaciones Equipo 3",
    "slug": "evacuaciones-equipo3",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "evacuaciones",
    "userInterfaceStyle": "light",
    "android": {
      "package": "ar.ailab.equipo3.evacuaciones",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationWhenInUsePermission": "Se usa tu ubicación solo cuando pedís asistencia o cargás tu domicilio."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Se usa la cámara solo para adjuntar una foto a tu pedido de asistencia.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ]
  }
}
