# Copiar a .env y completar. Nunca commitear .env.
POSTGRES_USER=evacuaciones
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=evacuaciones
POSTGRES_PORT=5432
DATABASE_URL=postgresql://evacuaciones:cambiar_esta_clave@localhost:5432/evacuaciones

# Seguridad (Fase 1 en adelante)
JWT_SECRET=CAMBIAR_generar_con_openssl_rand_hex_32
FIELD_ENCRYPTION_KEY=CAMBIAR_clave_base64_de_32_bytes

CORS_ORIGINS=http://localhost:5173,http://localhost:8081
PERMITIR_DATOS_POST_CORTE=false

# Clientes
VITE_API_URL=http://localhost:8000
# En un teléfono físico usar la IP LAN de la PC, p. ej. http://192.168.1.50:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
