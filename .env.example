# Copiar a .env y completar. Nunca commitear .env.
POSTGRES_USER=evacuaciones
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=evacuaciones
POSTGRES_PORT=5432
DATABASE_URL=postgresql://evacuaciones:cambiar_esta_clave@localhost:5432/evacuaciones

# Seguridad (Fase 1 en adelante)
# JWT_SECRET: mínimo 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=CAMBIAR_generar_con_openssl_rand_hex_32
# FIELD_ENCRYPTION_KEY: 32 bytes en base64. Generar con:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=CAMBIAR_clave_base64_de_32_bytes
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=7
PASSWORD_MIN_LONGITUD=10
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
RATE_LIMIT_ACTIVO=true
RATE_LIMIT_LOGIN=20/minute
RATE_LIMIT_REGISTRO=10/minute
# Cookie del refresh token: true en producción (HTTPS); false solo para desarrollo en http://localhost
COOKIE_SECURE=false

# Usuarios de demostración (ficticios), usados por `python -m app.db.seed`.
# Valores de ejemplo SOLO para desarrollo: cambiarlos en cualquier entorno compartido.
DEMO_PASSWORD=DemoEvacuaciones2026
DEMO_ADMIN_PASSWORD=DemoAdmin2026!

CORS_ORIGINS=http://localhost:5173,http://localhost:8081
PERMITIR_DATOS_POST_CORTE=false

# Clientes
VITE_API_URL=http://localhost:8000
# En un teléfono físico usar la IP LAN de la PC, p. ej. http://192.168.1.50:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
